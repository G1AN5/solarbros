# ============================================================================
# ENVIRONMENT VARIABLES — TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values:
#
#     Copy-Item .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================

# --- Supabase (frontend) ----------------------------------------------------
# Both values: Supabase Dashboard → Project Settings → API
#
# Project: "G1AN5's SolarBros Project"
# Ref:     hhynkgavxxuffzpyhifo   (already linked via the Supabase CLI)

VITE_SUPABASE_URL=https://hhynkgavxxuffzpyhifo.supabase.co

# The anon/public key. This key is public BY DESIGN and safe in the browser —
# access is controlled by Row Level Security policies in Postgres, not by
# keeping this key secret.
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# NOT USED BY THE APP — these are for your shell, not this file
# ----------------------------------------------------------------------------
# The Supabase MCP server (see .mcp.json) reads SUPABASE_ACCESS_TOKEN from your
# ENVIRONMENT, not from here. Set it in PowerShell instead:
#
#     [Environment]::SetEnvironmentVariable(
#       'SUPABASE_ACCESS_TOKEN', 'sbp_your_token', 'User')
#
# Get the token at: https://supabase.com/dashboard/account/tokens
# ============================================================================

# ⚠️ NEVER put the service_role key in this file or anywhere under src/.
# It bypasses Row Level Security entirely and would give anyone who opens
# your site full read/write access to every table. It belongs only in
# Supabase Edge Functions or server-side code.
