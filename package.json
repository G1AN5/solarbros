{
  "name": "solarbros",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "prepare": "husky || true",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:staff": "node scripts/verify-staff-admin.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:estimator": "node scripts/verify-estimator-pricing.mjs",
    "verify:forms": "node scripts/verify-public-forms.mjs",
    "verify:payments": "node scripts/verify-payments.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:procurement": "node scripts/verify-procurement.mjs",
    "verify:milestones": "node scripts/verify-milestones.mjs",
    "verify:notifications": "node scripts/verify-notifications.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:interconnect": "node scripts/verify-interconnect.mjs",
    "verify:support": "node scripts/verify-support.mjs",
    "verify:staff-approval": "node scripts/verify-staff-approval.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "clean:probes": "node scripts/clean-probes.mjs",
    "verify:search": "node scripts/verify-search-injection.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
